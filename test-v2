# Step 4: Create the dataset
dataset = Dataset.from_dict({"text": text_samples})

# Step 5: Load Gemma 2B model
model = FastLanguageModel.from_pretrained(
    "google/gemma-2-2b-it",
    load_in_4bit=True,
    device=device
)

# Step 6: Apply LoRA fine-tuning
model = FastLanguageModel.get_peft_model(
    model,
    r=16,
    lora_alpha=16,
    lora_dropout=0.1
)

# Step 7: Train the model on your samples
model.train_model(
    dataset,
    text_field="text",
    batch_size=1,
    epochs=2
)

# Step 8: Save the fine-tuned model to HuggingFace
model.push_to_hub("mia-bb55/MyStyleGemma")

# ==============================
# Step 9: Launch Interactive Gradio Box
# ==============================
def generate_text(prompt):
    return model.generate(prompt, max_length=400)

iface = gr.Interface(
    fn=generate_text,
    inputs="text",
    outputs="text",
    title="MyStyleGemma Writing Assistant",
    description="Type a prompt and see the model write in your style!"
)

iface.launch()
